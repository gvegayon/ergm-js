  "description": "A small, dependency-light Exponential Random Graph Model simulator for teaching and presentations.",
  "homepage": "https://gvegayon.github.io/ergm-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gvegayon/ergm-js.git"
  },
  "bugs": {
